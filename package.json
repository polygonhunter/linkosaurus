{
	"name": "autolink-keywords",
	"version": "4.5.0",
	"description": "Automatically links keywords to notes and turns URLs into Markdown links as you type, paste, or dictate. Includes autocomplete for inline aliases.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node esbuild.config.mjs test && node --test test-build/*.test.mjs",
		"lint": "eslint \"src/**/*.ts\" package.json",
		"release": "bash release.sh"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.0",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.13.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.72.1"
	}
}
